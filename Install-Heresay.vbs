' Install-Heresay.vbs - the whole Heresay installer, in one file.
' Source: https://github.com/villenull/Heresay/blob/main/Install-Heresay.vbs
'
' Double-click it. A setup window opens after a few seconds. No separate ZIP to
' download or extract, and no administrator rights are needed.
'
' The first install then downloads about 2.7 GB of speech models - leave the setup
' window open until it finishes.
'
' If Windows shows a "Windows protected your PC" message, click "More info", then
' "Run anyway". This file is open source: github.com/villenull/Heresay
'
' ---------------------------------------------------------------------------
' HOW IT IS SELF-CONTAINED: the setup package is carried inside this very file,
' base64-encoded, on the comment lines after the payload marker at the bottom.
' They are comments, so the script parses and runs normally; the code below reads
' this file back, strips the leading apostrophes, and decodes them.
'
' That is why the file is ~370 KB of mostly gibberish. Do not "clean it up", and
' do not edit it in anything that reflows or re-wraps long lines - that corrupts
' the payload. Regenerate it with build\Make-Installer-Vbs.ps1 instead.
'
' WHY wscript AND NOT a .cmd: powershell.exe is a console-subsystem binary, so any
' console-subsystem launcher flashes a console window at process creation whatever
' flags it passes. wscript.exe is a GUI-subsystem host and never owns a console,
' so the only window the recipient sees is the WPF setup window that
' installer\Install-Gui.ps1 opens itself.
'
' WHY WINDOWS POWERSHELL 5.1 AND NOT pwsh: 5.1 is on every Windows 10/11 machine
' at a fixed path. pwsh 7 may not be installed yet - bootstrapping it is the GUI
' installer's own job. The decode step runs under 5.1; -STA is required for the
' GUI itself because WPF only runs on a single-threaded apartment.
' ---------------------------------------------------------------------------
Option Explicit

Const APP_NAME = "Heresay setup"

' Assembled from pieces on purpose. If the whole marker appeared as one literal
' here, this line would be the first match when the script searches itself, and
' everything below it - including the rest of this code - would be read as
' payload. Make-Installer-Vbs.ps1 asserts the marker appears exactly once in the
' file it produces, which is the check that keeps this honest.
Dim MARKER
MARKER = "@@@HERESAY" & "-PAYLOAD-" & "BEGIN@@@"

Dim fso, shell, powershell, stage, psFile, f, selfPath, extraArgs, i

Set fso   = CreateObject("Scripting.FileSystemObject")
Set shell = CreateObject("WScript.Shell")

' Anything passed on the command line is forwarded to the GUI installer, which
' takes $args verbatim. Users pass none; this is how a tester reaches -WhatIf or
' -InstallRoot "C:\some path" without a separate build. Each argument is quoted
' individually so one containing spaces arrives as a single token.
extraArgs = ""
For i = 0 To WScript.Arguments.Count - 1
    If Len(extraArgs) > 0 Then extraArgs = extraArgs & ", "
    extraArgs = extraArgs & "'" & PsQuote(WScript.Arguments(i)) & "'"
Next

powershell = shell.ExpandEnvironmentStrings("%SystemRoot%") & _
             "\System32\WindowsPowerShell\v1.0\powershell.exe"

If Not fso.FileExists(powershell) Then
    MsgBox "Windows PowerShell was not found at the expected location:" & vbCrLf & vbCrLf & _
           "  " & powershell & vbCrLf & vbCrLf & _
           "Please run this on a standard Windows 10 or 11 machine.", _
           vbExclamation, APP_NAME
    WScript.Quit 1
End If

' A fresh folder per run, so two concurrent runs cannot collide and a stale
' extraction from an earlier attempt is never reused.
'
' GetTempName is the API for this. NOT ExpandEnvironmentStrings("%RANDOM%"):
' %RANDOM% is a cmd.exe dynamic pseudo-variable, not a real environment variable,
' so ExpandEnvironmentStrings returns the literal text "%RANDOM%" and every run
' lands in the same folder. Measured, not theorised - an earlier version of this
' script did exactly that and staged into "Heresay-Setup-%RANDOM%%RANDOM%".
Do
    stage = fso.BuildPath(fso.GetSpecialFolder(2), _
                          "Heresay-Setup-" & fso.GetBaseName(fso.GetTempName()))
    psFile = stage & ".ps1"
Loop While fso.FolderExists(stage) Or fso.FileExists(psFile)

selfPath = WScript.ScriptFullName

' The decode, extract and launch are written out as a PowerShell script rather
' than done here: VBScript has no binary file writing without pulling in ADODB,
' and this keeps the quoting in one place. Same approach as app\Run-Hidden.vbs.
Set f = fso.CreateTextFile(psFile, True, False)

f.WriteLine "$ErrorActionPreference = 'Stop'"
f.WriteLine "try {"
f.WriteLine "    $self   = '" & PsQuote(selfPath) & "'"
f.WriteLine "    $stage  = '" & PsQuote(stage) & "'"
f.WriteLine "    $marker = '" & PsQuote(MARKER) & "'"
f.WriteLine ""
f.WriteLine "    # Find the payload marker, then take every comment line below it."
f.WriteLine "    $lines = [System.IO.File]::ReadAllLines($self)"
f.WriteLine "    $start = -1"
f.WriteLine "    for ($i = 0; $i -lt $lines.Length; $i++) {"
f.WriteLine "        if ($lines[$i].Contains($marker)) { $start = $i; break }"
f.WriteLine "    }"
f.WriteLine "    if ($start -lt 0) {"
f.WriteLine "        throw 'The setup package is missing from this file. It may have been edited or truncated - please download Install-Heresay.vbs again.'"
f.WriteLine "    }"
f.WriteLine ""
f.WriteLine "    $sb = New-Object System.Text.StringBuilder"
f.WriteLine "    for ($i = $start + 1; $i -lt $lines.Length; $i++) {"
f.WriteLine "        $line = $lines[$i]"
f.WriteLine "        if ($line.Length -gt 1 -and $line[0] -eq [char]0x27) {"
f.WriteLine "            [void]$sb.Append($line.Substring(1))"
f.WriteLine "        }"
f.WriteLine "    }"
f.WriteLine "    if ($sb.Length -eq 0) {"
f.WriteLine "        throw 'The setup package in this file is empty. Please download Install-Heresay.vbs again.'"
f.WriteLine "    }"
f.WriteLine ""
f.WriteLine "    try { $bytes = [System.Convert]::FromBase64String($sb.ToString()) }"
f.WriteLine "    catch { throw 'The setup package in this file is damaged. This usually means the file was edited or re-wrapped by a text editor. Please download Install-Heresay.vbs again.' }"
f.WriteLine ""
f.WriteLine "    New-Item -ItemType Directory -Force -Path $stage | Out-Null"
f.WriteLine "    $zip = Join-Path $stage 'Heresay-Setup.zip'"
f.WriteLine "    [System.IO.File]::WriteAllBytes($zip, $bytes)"
f.WriteLine ""
f.WriteLine "    Add-Type -AssemblyName System.IO.Compression.FileSystem"
f.WriteLine "    [System.IO.Compression.ZipFile]::ExtractToDirectory($zip, $stage)"
f.WriteLine "    Remove-Item -LiteralPath $zip -Force -ErrorAction SilentlyContinue"
f.WriteLine ""
f.WriteLine "    $gui = Join-Path $stage 'Heresay-Setup\installer\Install-Gui.ps1'"
f.WriteLine "    if (-not (Test-Path -LiteralPath $gui)) {"
f.WriteLine "        throw 'The setup package unpacked but installer\Install-Gui.ps1 is not in it. Please download Install-Heresay.vbs again.'"
f.WriteLine "    }"
f.WriteLine "} catch {"
f.WriteLine "    Add-Type -AssemblyName PresentationFramework"
f.WriteLine "    $msg = 'Heresay could not start its installer.' +"
f.WriteLine "           [Environment]::NewLine + [Environment]::NewLine + $_.Exception.Message"
f.WriteLine "    [void][System.Windows.MessageBox]::Show($msg, 'Heresay setup', 'OK', 'Error')"
f.WriteLine "    exit 1"
f.WriteLine "}"
f.WriteLine ""
f.WriteLine "# Run the installer IN THIS PROCESS rather than starting another one."
f.WriteLine "#"
f.WriteLine "# Spawning a second powershell here (Start-Process) put three process hops"
f.WriteLine "# between the user's double-click and the setup window: wscript -> this"
f.WriteLine "# script -> the GUI. Windows' foreground lock then refuses the new window the"
f.WriteLine "# foreground, so the setup window opened centred, visible, and BEHIND"
f.WriteLine "# everything else - measured 2026-09-03, the user saw nothing happen at all."
f.WriteLine "#"
f.WriteLine "# In-process keeps the setup window in the foreground. This is deliberately"
f.WriteLine "# outside the try above: from here on, failures belong to the installer and"
f.WriteLine "# it reports them in its own window."
f.WriteLine "$forward = @(" & extraArgs & ")"
f.WriteLine "& $gui @forward"

f.Close

' run=0 is SW_HIDE; bWaitOnReturn=False lets wscript exit immediately. The only
' window the recipient sees is the setup window the installer opens itself.
'
' This process is the one that ends up hosting the WPF setup window, so -STA is
' REQUIRED - WPF only runs on a single-threaded apartment - and -NonInteractive
' is deliberately absent. Hiding the console is run=0's job, not -WindowStyle:
' passing both is what an earlier version did, and the setup window then never
' took the foreground.
shell.Run """" & powershell & """ -NoProfile -STA -ExecutionPolicy Bypass" & _
          " -File """ & psFile & """", 0, False

' Escapes a value for a PowerShell single-quoted string, where the only special
' character is the apostrophe and it is escaped by doubling.
Function PsQuote(value)
    PsQuote = Replace(value, "'", "''")
End Function

